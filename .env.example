# Environment Configuration for KharchaAI Backend
PROJECT_NAME="KharchaAI API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# In production, generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="kharcha_dev_secret_key_change_in_production_9f83a21b4e"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Phase 1: Local SQLite development database
# Phase 2: PostgreSQL e.g. "postgresql+psycopg://postgres:password@localhost:5432/kharcha_ai"
DATABASE_URL="sqlite:///./kharcha_dev.db"

# Phase 3: AI Receipt Scanning & Vision Configuration
# Supported providers: "gemini", "rule_based"
RECEIPT_AI_PROVIDER="gemini"
# Get your Google Gemini API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-1.5-flash"
RECEIPT_MAX_UPLOAD_BYTES=5242880
